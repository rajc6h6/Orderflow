# OrderFlow — Environment Variables Template
# -----------------------------------------------
# Copy this file to .env.local for local dev,
# OR set these as Environment Variables in Vercel.
#
# DO NOT commit .env or .env.local to git!

# Google Apps Script Web App URL (deploy your script and paste the URL here)
# VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Gemini API Key — get one free at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
